#!/bin/sh
# Reels Engine pre-commit hook: blocks env files and scans staged changes with gitleaks.
# Installed by `npm install` (package.json "prepare" -> .githooks/install.sh).
set -eu

# 1) Never commit a real env file (only *.env.example is allowed).
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v -E '\.env\.example$' || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refusing to commit env files:" >&2
  echo "$bad" >&2
  exit 1
fi

# 2) Secret scan of the staged diff.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (macOS: brew install gitleaks). Commit blocked." >&2
  exit 1
fi
if gitleaks git --help 2>/dev/null | grep -q -- '--staged'; then
  gitleaks git --staged --redact --no-banner --config .gitleaks.toml .
else
  gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
fi
