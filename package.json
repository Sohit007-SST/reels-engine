{
  "name": "reels-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Reels Engine: trend-informed, original 9:16 reels produced, checked and published through official APIs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx src/cli/doctor.ts",
    "setup:meta": "tsx src/cli/setup-meta.ts",
    "setup:telegram": "tsx src/cli/setup-telegram.ts",
    "agents:sync": "tsx src/cli/agents-sync.ts",
    "preview": "remotion studio remotion/index.ts",
    "render": "tsx src/render/cli.ts render",
    "reel:fixture": "tsx src/pipeline/produce.ts --fixture",
    "trends": "tsx src/trends/cli.ts",
    "produce": "tsx src/pipeline/produce.ts",
    "publish": "tsx src/pipeline/publish.ts",
    "engage": "tsx src/pipeline/engage.ts",
    "analyze": "tsx src/pipeline/analyze.ts",
    "learn": "tsx src/pipeline/learn.ts",
    "report": "tsx src/pipeline/report.ts",
    "report:dummy": "tsx src/cli/report-dummy.ts",
    "qa": "tsx src/qa/cli.ts",
    "render:fixture": "tsx src/render/cli.ts fixture",
    "render:smoke": "tsx src/render/cli.ts smoke",
    "audio": "tsx src/media/cli.ts voice",
    "audio:assets": "tsx src/media/cli.ts assets",
    "prepare": "sh .githooks/install.sh",
    "publish:cron": "tsx src/cli/gen-publish-cron.ts",
    "github:secrets": "tsx src/cli/github-secrets.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/captions": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/layout-utils": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "dotenv": "18.0.9",
    "fast-xml-parser": "5.12.0",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
